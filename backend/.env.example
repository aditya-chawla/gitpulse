# Copy to backend/.env for local development. Never commit the real file.
# In production these are set in the Render dashboard / render.yaml instead.

# --- Server ---
# Port to listen on. Render sets this automatically.
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info

# --- Database ---
# Postgres connection string. Locally (running the binary on the host) use the
# docker-compose database on port 5433; docker-compose overrides this for the
# backend container. In production: the Neon connection string (sslmode=require).
DATABASE_URL=postgres://gitpulse:gitpulse@localhost:5433/gitpulse?sslmode=disable

# --- GitHub App (github.com/settings/apps -> your app) ---
# Client ID from the app's "About" section. Also used as the JWT issuer when
# gitpulse authenticates as the app.
GITHUB_CLIENT_ID=
# "Client secrets" -> Generate a new client secret. Used for sign-in only.
GITHUB_CLIENT_SECRET=
# "Private keys" -> Generate a private key. Paste the .pem as base64 on one line
# (PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.pem")),
# macOS/Linux: base64 -w0 key.pem). Raw PEM with literal \n escapes also works.
# Lets gitpulse mint short-lived installation tokens; treat it like a password.
GITHUB_APP_PRIVATE_KEY=
# Optional: the app's webhook secret (GitHub App -> Webhook -> Secret). Used to
# verify pull_request deliveries for the PR assistant. Without it the webhook
# endpoint answers 503 and PRs are picked up by the 30-minute catch-up sync.
# Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Must exactly match one of the app's "Callback URL" entries.
# Local: http://localhost:8080/api/auth/callback
OAUTH_REDIRECT_URL=http://localhost:8080/api/auth/callback

# --- Access control ---
# Comma-separated GitHub usernames allowed to sign in (case-insensitive).
ALLOWED_USERS=harshit3011

# --- Secrets ---
# (TOKEN_ENC_KEY from v1 is no longer used: no GitHub user tokens are stored.)
# Shared secret for POST /api/scan from GitHub Actions (header X-Scan-Secret).
# At least 24 characters. Generate: openssl rand -hex 32
SCAN_SECRET=

# --- Frontend / browser ---
# Where the browser is sent after sign-in. "/" when frontend and API share an
# origin (production via Render rewrite). Locally: the Vite dev server.
FRONTEND_URL=http://localhost:5173
# Extra origins allowed to call the API with cookies (comma-separated). Leave
# empty for same-origin setups. Only needed if the frontend calls the API on a
# different origin (then also set COOKIE_SAMESITE=none).
CORS_ALLOWED_ORIGINS=
# Secure cookies require HTTPS. Set false only for local http://localhost.
COOKIE_SECURE=false
# lax (default, same-origin) | strict | none (cross-origin fallback; needs COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# Optional: directory of the built frontend to serve from the Go server
# (single-service fallback). Leave empty normally.
STATIC_DIR=

# --- Profile README (optional) ---
# Repo whose README gets the gitpulse block. Default (empty): <login>/<login>.
# For local development point it at a throwaway repo so tests never touch
# your real profile, e.g. you/gitpulse-sandbox. Must be a repo you own.
PROFILE_README_REPO=

# --- AI (optional) ---
# gitpulse is fully usable without AI: every AI feature has a rule-based
# fallback. With LLM_PROVIDER unset, AI turns on automatically when
# ANTHROPIC_API_KEY is set and stays off (no network calls) when it isn't.
# none | anthropic. Set "none" to keep AI off even with a key present.
LLM_PROVIDER=
# Anthropic API key (console.anthropic.com -> API keys). Leave empty for no AI.
ANTHROPIC_API_KEY=
# Model ID. Prices for claude-haiku-5-5, claude-sonnet-5-5 and claude-opus-5-5
# are built in; any other model needs both LLM_PRICE_* values below.
LLM_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max | default. Sent only to models known to
# support effort; "default" omits it. Low keeps thinking (billed as output) small.
LLM_EFFORT=low
# Hard monthly cap in USD (UTC calendar month). Every call reserves its
# worst-case cost first; when the cap would be exceeded, AI is skipped and the
# rule-based output is used. 0 = never spend.
LLM_MONTHLY_BUDGET_USD=5
# Largest prompt sent in one request (estimated conservatively at ~3 chars per
# token). Keeps Haiku 5.5 under its 100k-token long-prompt price tier.
LLM_MAX_INPUT_TOKENS=24000
# Max output tokens per request, including thinking tokens.
LLM_MAX_OUTPUT_TOKENS=4000
# Optional price override in USD per million tokens (both or neither).
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
