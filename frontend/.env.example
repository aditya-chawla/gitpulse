# Frontend build-time variables (Vite inlines VITE_* at build time).

# Base URL of the API. Leave EMPTY for the default same-origin setup: locally
# the Vite dev server proxies /api to the backend, and in production the Render
# static site rewrites /api/* to the backend service.
# Set it only for the cross-origin fallback, e.g. https://gitpulse-api.onrender.com
# (then also set CORS_ALLOWED_ORIGINS and COOKIE_SAMESITE=none on the backend).
VITE_API_BASE_URL=

# Dev only: where the Vite dev server proxies /api (docker-compose sets this).
# VITE_PROXY_TARGET=http://localhost:8080
